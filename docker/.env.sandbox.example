# Sandbox environment template — copy to .env.sandbox and fill in.
# DO NOT commit the real .env.sandbox.

# ── Demo Postgres (resettable, holds Nordica seed data) ──
POSTGRES_USER=csmp
POSTGRES_PASSWORD=replace-me-with-a-strong-password
POSTGRES_DB=csmp_v2
DATABASE_URL=postgresql://csmp:replace-me-with-a-strong-password@postgres:5432/csmp_v2?schema=public

# ── Feedback Postgres (separate container, NEVER reset) ──
FEEDBACK_POSTGRES_USER=csmp
FEEDBACK_POSTGRES_PASSWORD=different-strong-password-here
FEEDBACK_POSTGRES_DB=csmp_feedback
FEEDBACK_DATABASE_URL=postgresql://csmp:different-strong-password-here@feedback-postgres:5432/csmp_feedback?schema=public

# ── API ──
# 32+ random chars; MUST differ from the production JWT_SECRET so a leaked
# sandbox token cannot impersonate a prod user.
JWT_SECRET=generate-with-openssl-rand-hex-32-and-keep-distinct-from-prod
JWT_EXPIRES_IN=30m
SANDBOX_RESET_INTERVAL_HOURS=48
CORS_ORIGIN=https://demo.csmp.marekmalczewski.pl

# ── Owner controls ──
# Used to authenticate calls to /admin/* (invite management, feedback list).
# Keep this off the production CLAUDE.md and out of the public runbook.
OWNER_TOKEN=generate-with-openssl-rand-hex-32

# ── Owner email notifications (optional) ──
# Each feedback submission triggers a notification to OWNER_NOTIFY_EMAIL via
# the configured SMTP transport. Leave OWNER_NOTIFY_EMAIL blank to disable.
OWNER_NOTIFY_EMAIL=mac.damian@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── ntfy notifications on invite use (optional) ──
# Each successful POST /sandbox/login-as fires a notification. Leave
# NTFY_INVITE_URL blank to disable. URL must include the topic path,
# e.g. https://ntfy.marekmalczewski.pl/csmp-sandbox-invites
# NTFY_AUTH_HEADER is optional — set to a full header value like
# "Bearer tk_xxxxx" or "Basic base64(user:pass)" when the topic is
# access-controlled. Leave blank for public topics.
NTFY_INVITE_URL=
NTFY_AUTH_HEADER=

# ── Host port bindings (must NOT collide with production at 8080/3001) ──
WEB_HOST_PORT=8081
API_HOST_PORT=3002
