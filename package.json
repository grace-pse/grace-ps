{
  "name": "csmp-v2",
  "version": "0.1.0",
  "private": true,
  "description": "CSMP Risk Manager — self-hostable physical security risk assessment platform",
  "scripts": {
    "dev": "pnpm -r --parallel --filter=@csmp/server --filter=@csmp/client dev",
    "build": "pnpm -r --filter=@csmp/shared --filter=@csmp/server --filter=@csmp/client build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter=@csmp/server prisma migrate dev",
    "db:generate": "pnpm --filter=@csmp/server prisma generate",
    "db:seed": "pnpm --filter=@csmp/server db:seed",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
